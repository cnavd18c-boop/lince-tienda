<section class=\"landing-comparison-section\" style=\"background: #0f1217; color: #ffffff; padding: 70px 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\">
  <div style=\"max-width: 1050px; margin: 0 auto;\">
    
    <!-- Encabezado de la Sección -->
    <div style=\"text-align: center; margin-bottom: 50px;\">
      <span style=\"color: #ff6b9d; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.9rem;\">INGENIERÍA VS TRADICIÓN</span>
      <h2 style=\"font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin: 12px 0; font-weight: 800; color: #ffffff;\">
        Por qué nuestros Ganchos Anatómicos superan a los guantes y correas comunes
      </h2>
      <p style=\"color: #8b949e; font-size: 1.05rem; max-width: 680px; margin: 0 auto;\">
        No todos los soportes son iguales. Descubre por qué el gancho de acero templado es la única solución que realmente libera tus manos.
      </p>
    </div>

    <!-- Contenedor Tabla Responsive -->
    <div style=\"overflow-x: auto; background: #161b22; border-radius: 18px; border: 1px solid #30363d; box-shadow: 0 10px 30px rgba(0,0,0,0.4);\">
      <table style=\"width: 100%; border-collapse: collapse; text-align: left; min-width: 650px;\">
        <thead>
          <tr style=\"border-bottom: 2px solid #30363d;\">
            <th style=\"padding: 22px 20px; font-size: 1rem; color: #8b949e; width: 34%;\">Beneficio Clínico & Deportivo</th>
            <th style=\"padding: 22px 20px; font-size: 1.05rem; color: #ff6b9d; background: rgba(255, 107, 157, 0.08); width: 26%; font-weight: 800; border-left: 1px solid #ff6b9d33; border-right: 1px solid #ff6b9d33;\">
              🦾 Gancho Anatómico Lince
            </th>
            <th style=\"padding: 22px 20px; font-size: 0.95rem; color: #c9d1d9; width: 20%;\">🥊 Guantes Comunes</th>
            <th style=\"padding: 22px 20px; font-size: 0.95rem; color: #c9d1d9; width: 20%;\">🎗️ Straps de Tela</th>
          </tr>
        </thead>
        <tbody style=\"font-size: 0.95rem;\">
          <!-- Fila 1 -->
          <tr style=\"border-bottom: 1px solid #21262d;\">
            <td style=\"padding: 18px 20px; font-weight: 600; color: #f0f6fc;\">Cero fatiga en dedos y manos</td>
            <td style=\"padding: 18px 20px; background: rgba(255, 107, 157, 0.05); color: #00e676; font-weight: 700; border-left: 1px solid #ff6b9d33; border-right: 1px solid #ff6b9d33;\">
              ✅ 100% libre (el gancho sostiene el peso)
            </td>
            <td style=\"padding: 18px 20px; color: #ff5252;\">❌ No (los dedos cargan igual)</td>
            <td style=\"padding: 18px 20px; color: #e3b341;\">⚠️ Parcial (los dedos aún aprietan)</td>
          </tr>
          <!-- Fila 2 -->
          <tr style=\"border-bottom: 1px solid #21262d;\">
            <td style=\"padding: 18px 20px; font-weight: 600; color: #f0f6fc;\">Protección de uñas acrílicas y manicura</td>
            <td style=\"padding: 18px 20px; background: rgba(255, 107, 157, 0.05); color: #00e676; font-weight: 700; border-left: 1px solid #ff6b9d33; border-right: 1px solid #ff6b9d33;\">
              ✅ 100% Intactas (sin contacto de uñas)
            </td>
            <td style=\"padding: 18px 20px; color: #ff5252;\">❌ Se parten contra el tejido</td>
            <td style=\"padding: 18px 20px; color: #ff5252;\">❌ Se dañan al amarrar la barra</td>
          </tr>
          <!-- Fila 3 -->
          <tr style=\"border-bottom: 1px solid #21262d;\">
            <td style=\"padding: 18px 20px; font-weight: 600; color: #f0f6fc;\">Cero callos y durezas en las palmas</td>
            <td style=\"padding: 18px 20px; background: rgba(255, 107, 157, 0.05); color: #00e676; font-weight: 700; border-left: 1px solid #ff6b9d33; border-right: 1px solid #ff6b9d33;\">
              ✅ Sí (la palma no roza el hierro rugoso)
            </td>
            <td style=\"padding: 18px 20px; color: #e3b341;\">⚠️ Salen callos por el pliegue</td>
            <td style=\"padding: 18px 20px; color: #ff5252;\">❌ Fricción severa y callos</td>
          </tr>
          <!-- Fila 4 -->
          <tr style=\"border-bottom: 1px solid #21262d;\">
            <td style=\"padding: 18px 20px; font-weight: 600; color: #f0f6fc;\">Velocidad de anclaje a la barra</td>
            <td style=\"padding: 18px 20px; background: rgba(255, 107, 157, 0.05); color: #00e676; font-weight: 700; border-left: 1px solid #ff6b9d33; border-right: 1px solid #ff6b9d33;\">
              ✅ 2 Segundos (solo enganchar y tirar)
            </td>
            <td style=\"padding: 18px 20px; color: #c9d1d9;\">Inmediato pero sin agarre</td>
            <td style=\"padding: 18px 20px; color: #ff5252;\">❌ Lento (30 seg enrollando cada mano)</td>
          </tr>
          <!-- Fila 5 -->
          <tr style=\"border-bottom: 1px solid #21262d;\">
            <td style=\"padding: 18px 20px; font-weight: 600; color: #f0f6fc;\">Capacidad máxima de soporte</td>
            <td style=\"padding: 18px 20px; background: rgba(255, 107, 157, 0.05); color: #00e676; font-weight: 700; border-left: 1px solid #ff6b9d33; border-right: 1px solid #ff6b9d33;\">
              ✅ 750 LBS (Acero comprimido macizo)
            </td>
            <td style=\"padding: 18px 20px; color: #ff5252;\">❌ 0 LBS (no tiene tracción)</td>
            <td style=\"padding: 18px 20px; color: #e3b341;\">⚠️ 200-300 LBS (se desgasta el hilo)</td>
          </tr>
          <!-- Fila 6 -->
          <tr>
            <td style=\"padding: 18px 20px; font-weight: 600; color: #f0f6fc;\">Acolchado de muñeca para no lastimar</td>
            <td style=\"padding: 18px 20px; background: rgba(255, 107, 157, 0.05); color: #00e676; font-weight: 700; border-left: 1px solid #ff6b9d33; border-right: 1px solid #ff6b9d33;\">
              ✅ 7 mm Neopreno anatómico de alta densidad
            </td>
            <td style=\"padding: 18px 20px; color: #ff5252;\">❌ 1-2 mm tela simple</td>
            <td style=\"padding: 18px 20px; color: #ff5252;\">❌ Sin acolchado (corta circulación)</td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</section>

