{{ 'section.css' | asset_url | stylesheet_tag }}

<section class=\"landing-hero-ganchos\" style=\"background: linear-gradient(135deg, #0d0f12 0%, #1a1e24 100%); color: #ffffff; padding: 60px 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\">
  <div style=\"max-width: 1100px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 40px;\">
    
    <!-- Columna Texto y Oferta -->
    <div style=\"flex: 1 1 520px; min-width: 300px;\">
      <div style=\"display: inline-flex; align-items: center; gap: 8px; background: rgba(255, 107, 157, 0.15); border: 1px solid #ff6b9d; color: #ff8ab3; padding: 6px 14px; border-radius: 50px; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 20px;\">
        <span>⭐ HERO PRODUCT FIT FEM</span>
        <span>•</span>
        <span>ANCLAJE DE 750 LBS</span>
      </div>

      <h1 style=\"font-size: clamp(2rem, 4vw, 3.1rem); line-height: 1.15; font-weight: 800; margin: 0 0 20px 0; color: #ffffff;\">
        Levanta el doble de peso <span style=\"background: linear-gradient(90deg, #ff6b9d, #ffa3c4); -webkit-background-clip: text; -webkit-text-fill-color: transparent;\">sin dolor en las manos</span> ni callosidades.
      </h1>

      <p style=\"font-size: 1.15rem; line-height: 1.6; color: #d0d7de; margin: 0 0 28px 0;\">
        ¿Tus dedos se rinden antes que tus glúteos? Este soporte anatómico con gancho de acero templado y neopreno de 7 mm transfiere el 100% de la carga a tus músculos. <strong>Cero tensión en dedos, cero callos y tu manicura intacta.</strong>
      </p>

      <!-- Puntos de Valor Rápido -->
      <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-bottom: 32px;\">
        <div style=\"display: flex; align-items: center; gap: 10px;\">
          <span style=\"color: #00c853; font-size: 1.2rem;\">✔</span>
          <span style=\"font-size: 0.95rem; color: #e6edf3;\">Glúteos y espalda al fallo real</span>
        </div>
        <div style=\"display: flex; align-items: center; gap: 10px;\">
          <span style=\"color: #00c853; font-size: 1.2rem;\">✔</span>
          <span style=\"font-size: 0.95rem; color: #e6edf3;\">Uñas acrílicas 100% protegidas</span>
        </div>
        <div style=\"display: flex; align-items: center; gap: 10px;\">
          <span style=\"color: #00c853; font-size: 1.2rem;\">✔</span>
          <span style=\"font-size: 0.95rem; color: #e6edf3;\">Dominadas y jalones sin dolor</span>
        </div>
        <div style=\"display: flex; align-items: center; gap: 10px;\">
          <span style=\"color: #00c853; font-size: 1.2rem;\">✔</span>
          <span style=\"font-size: 0.95rem; color: #e6edf3;\">Neopreno ultra-denso de 7 mm</span>
        </div>
      </div>

      <!-- Botón de Acción y Disparadores -->
      <div style=\"display: flex; flex-direction: column; gap: 14px;\">
        <a href=\"{{ section.settings.button_link | default: '/products' }}\" style=\"display: inline-block; text-align: center; background: linear-gradient(90deg, #ff4081, #ff6b9d); color: #ffffff; text-decoration: none; padding: 18px 36px; border-radius: 12px; font-size: 1.15rem; font-weight: 800; box-shadow: 0 8px 24px rgba(255, 64, 129, 0.4); transition: transform 0.2s ease;\">
          {{ section.settings.button_text | default: '¡ORDENAR AHORA - PAGO MÓVIL / ZELLE!' }}
        </a>
        <div style=\"display: flex; flex-wrap: wrap; align-items: center; gap: 16px; font-size: 0.85rem; color: #8b949e;\">
          <span>🛵 Delivery en Caracas & Envíos MRW / Zoom</span>
          <span>•</span>
          <span>🔒 Garantía contra defectos de fábrica</span>
        </div>
      </div>
    </div>

    <!-- Columna Visual Destacada -->
    <div style=\"flex: 1 1 420px; min-width: 280px; position: relative;\">
      <div style=\"background: radial-gradient(circle, rgba(255,107,157,0.2) 0%, rgba(20,24,30,0) 70%); position: absolute; width: 100%; height: 100%; top: 0; left: 0; pointer-events: none;\"></div>
      
      <div style=\"background: #161b22; border: 1px solid #30363d; border-radius: 20px; padding: 30px; box-shadow: 0 16px 40px rgba(0,0,0,0.5); text-align: center;\">
        <div style=\"background: #21262d; border-radius: 14px; padding: 24px; margin-bottom: 20px;\">
          <div style=\"font-size: 4rem; margin-bottom: 10px;\">🦾✨</div>
          <h3 style=\"margin: 0 0 8px 0; font-size: 1.4rem; color: #ffffff;\">Muñequera Gancho Anatómico Pro</h3>
          <p style=\"margin: 0; color: #8b949e; font-size: 0.9rem;\">Acero forjado + Revestimiento Engomado Anti-resbalante</p>
        </div>

        <div style=\"display: flex; justify-content: space-around; background: #0d1117; padding: 16px; border-radius: 12px; border: 1px solid #30363d;\">
          <div>
            <div style=\"font-size: 1.3rem; font-weight: 800; color: #ff6b9d;\">750 LBS</div>
            <div style=\"font-size: 0.75rem; color: #8b949e; text-transform: uppercase;\">Capacidad Carga</div>
          </div>
          <div style=\"border-left: 1px solid #30363d;\"></div>
          <div>
            <div style=\"font-size: 1.3rem; font-weight: 800; color: #00c853;\">7 MM</div>
            <div style=\"font-size: 0.75rem; color: #8b949e; text-transform: uppercase;\">Grosor Neopreno</div>
          </div>
          <div style=\"border-left: 1px solid #30363d;\"></div>
          <div>
            <div style=\"font-size: 1.3rem; font-weight: 800; color: #ffa3c4;\">2 SEG</div>
            <div style=\"font-size: 0.75rem; color: #8b949e; text-transform: uppercase;\">Anclaje Rápido</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  \"name\": \"Landing Hero Ganchos\",
  \"settings\": [
    {
      \"type\": \"text\",
      \"id\": \"button_text\",
      \"label\": \"Texto del Botón\",
      \"default\": \"¡ORDENAR AHORA - PAGO MÓVIL / ZELLE!\"
    },
    {
      \"type\": \"url\",
      \"id\": \"button_link\",
      \"label\": \"Enlace del Botón\"
    }
  ],
  \"presets\": [
    {
      \"name\": \"Landing Hero Ganchos\"
    }
  ]
}
{% endschema %}
