<section class=\"landing-pago-venezuela\" style=\"background: #0d1117; color: #ffffff; padding: 65px 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\">
  <div style=\"max-width: 1050px; margin: 0 auto;\">
    
    <div style=\"text-align: center; margin-bottom: 45px;\">
      <span style=\"color: #00e676; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.85rem;\">ENVÍOS & PAGOS EN VENEZUELA 🇻🇪</span>
      <h2 style=\"font-size: clamp(1.8rem, 3.5vw, 2.5rem); margin: 10px 0; font-weight: 800; color: #ffffff;\">
        Compra Fácil, Rápido y 100% Seguro
      </h2>
      <p style=\"color: #8b949e; font-size: 1.05rem; max-width: 620px; margin: 0 auto;\">
        Aceptamos los métodos de pago más cómodos y despachamos tu pedido el mismo día.
      </p>
    </div>

    <!-- Rejilla de Métodos de Pago y Despacho -->
    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 40px;\">
      
      <!-- Tarjeta 1: Pago Móvil -->
      <div style=\"background: #161b22; border: 1px solid #30363d; border-radius: 16px; padding: 26px 20px; text-align: left; transition: transform 0.2s;\">
        <div style=\"font-size: 2.2rem; margin-bottom: 14px;\">📱</div>
        <h3 style=\"margin: 0 0 10px 0; font-size: 1.2rem; color: #ffffff;\">Pago Móvil al BCV</h3>
        <p style=\"margin: 0; color: #8b949e; font-size: 0.9rem; line-height: 1.5;\">
          Paga en bolívares a la tasa oficial del día sin comisiones extras: Banco de Venezuela, Mercantil, Banesco y Bancamiga.
        </p>
      </div>

      <!-- Tarjeta 2: Divisas & Zelle -->
      <div style=\"background: #161b22; border: 1px solid #30363d; border-radius: 16px; padding: 26px 20px; text-align: left;\">
        <div style=\"font-size: 2.2rem; margin-bottom: 14px;\">💵</div>
        <h3 style=\"margin: 0 0 10px 0; font-size: 1.2rem; color: #ffffff;\">Zelle, Binance & Cash</h3>
        <p style=\"margin: 0; color: #8b949e; font-size: 0.9rem; line-height: 1.5;\">
          Aceptamos transferencias Zelle directas, Binance Pay (USDT) y efectivo en divisas para entregas en persona en Caracas.
        </p>
      </div>

      <!-- Tarjeta 3: Delivery en Caracas -->
      <div style=\"background: #161b22; border: 1px solid #30363d; border-radius: 16px; padding: 26px 20px; text-align: left;\">
        <div style=\"font-size: 2.2rem; margin-bottom: 14px;\">🛵</div>
        <h3 style=\"margin: 0 0 10px 0; font-size: 1.2rem; color: #ffffff;\">Delivery & Entregas Caracas</h3>
        <p style=\"margin: 0; color: #8b949e; font-size: 0.9rem; line-height: 1.5;\">
          Entregas personales sin costo en punto acordado (CC Concresa, Baruta) o delivery express en moto a tu casa u oficina.
        </p>
      </div>

      <!-- Tarjeta 4: Envíos Nacionales -->
      <div style=\"background: #161b22; border: 1px solid #30363d; border-radius: 16px; padding: 26px 20px; text-align: left;\">
        <div style=\"font-size: 2.2rem; margin-bottom: 14px;\">📦</div>
        <h3 style=\"margin: 0 0 10px 0; font-size: 1.2rem; color: #ffffff;\">Envíos a Toda Venezuela</h3>
        <p style=\"margin: 0; color: #8b949e; font-size: 0.9rem; line-height: 1.5;\">
          Despacho prioritario por Zoom, MRW y Tealca con número de guía digital enviado en menos de 24 horas hábiles.
        </p>
      </div>

    </div>

    <!-- Banner de Soporte Inmediato WhatsApp -->
    <div style=\"background: linear-gradient(90deg, #1b281f 0%, #16221a 100%); border: 1px solid #2ea043; border-radius: 16px; padding: 24px 30px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px;\">
      <div style=\"display: flex; align-items: center; gap: 16px;\">
        <div style=\"background: #238636; width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;\">
          💬
        </div>
        <div>
          <h4 style=\"margin: 0 0 4px 0; font-size: 1.1rem; color: #ffffff;\">¿Prefieres ordenar directamente por WhatsApp?</h4>
          <p style=\"margin: 0; color: #7ee787; font-size: 0.9rem;\">Atención humana inmediata, cálculo de tasa y confirmación al instante.</p>
        </div>
      </div>
      <div>
        <a href=\"https://wa.me/?text=Hola%20quiero%20ordenar%20las%20muñequeras%20con%20gancho%20rosa\" target=\"_blank\" style=\"display: inline-block; background: #238636; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-weight: 700; font-size: 0.95rem;\">
          Chatear por WhatsApp
        </a>
      </div>
    </div>

  </div>
</section>

