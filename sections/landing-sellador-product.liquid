{% render 'social-proof-toast' %}

<div class="sellador-landing-container" style="background: #ffffff; color: #111827; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; padding: 20px 16px 60px;">
  
  <!-- Banner Destacado Superior (Igual a Venex Import) -->
  <div style="max-width: 1050px; margin: 0 auto 24px; text-align: center;">
    <div style="background: #0066cc; color: #ffffff; padding: 12px 20px; border-radius: 8px; font-weight: 800; font-size: clamp(0.95rem, 2.5vw, 1.25rem); text-transform: uppercase; letter-spacing: 0.5px; box-shadow: 0 4px 12px rgba(0,102,204,0.25);">
      🛡️ HOGAR PROTEGIDO CON UNA SOLUCIÓN SIMPLE Y EFECTIVA
    </div>
  </div>

  <div style="max-width: 1050px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 36px; align-items: flex-start;">
    
    <!-- Columna Galería e Imagen del Producto -->
    <div style="flex: 1 1 460px; min-width: 300px;">
      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; position: relative; box-shadow: 0 8px 24px rgba(0,0,0,0.06);">
        
        <!-- Badge de Escasez Flotante -->
        <div style="position: absolute; top: 14px; left: 14px; z-index: 10; background: #dc2626; color: #ffffff; font-size: 0.8rem; font-weight: 800; padding: 6px 12px; border-radius: 20px; display: flex; align-items: center; gap: 6px; box-shadow: 0 2px 8px rgba(220,38,38,0.4);">
          <span style="animation: pulse 1.5s infinite;">🔥</span> ¡ÚLTIMAS 14 UNIDADES EN STOCK!
        </div>

        <!-- Imagen Demostrativa SVG de Alta Fidelidad del Sellador Jaysuing -->
        <div style="width: 100%; height: 420px; background: linear-gradient(180deg, #f1f5f9 0%, #e2e8f0 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative;">
          <svg viewBox="0 0 400 380" style="width: 100%; max-height: 380px; padding: 20px;" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="jarGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ffffff" />
                <stop offset="50%" stop-color="#f8fafc" />
                <stop offset="100%" stop-color="#cbd5e1" />
              </linearGradient>
              <linearGradient id="blueBanner" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#1e3a8a" />
                <stop offset="100%" stop-color="#2563eb" />
              </linearGradient>
              <linearGradient id="dropGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#60a5fa" />
                <stop offset="100%" stop-color="#1d4ed8" />
              </linearGradient>
            </defs>
            
            <!-- Tapa del pote -->
            <rect x="110" y="80" width="180" height="30" rx="6" fill="#f1f5f9" stroke="#94a3b8" stroke-width="2"/>
            <line x1="110" y1="95" x2="290" y2="95" stroke="#cbd5e1" stroke-width="2"/>
            
            <!-- Cuerpo del Pote Jaysuing -->
            <path d="M 115 110 L 285 110 L 275 300 A 10 10 0 0 1 265 310 L 135 310 A 10 10 0 0 1 125 300 Z" fill="url(#jarGrad)" stroke="#94a3b8" stroke-width="2"/>
            
            <!-- Franja Azul Jaysuing -->
            <rect x="120" y="140" width="160" height="70" fill="url(#blueBanner)" rx="3"/>
            <text x="200" y="168" font-family="Arial, sans-serif" font-weight="900" font-size="22" fill="#ffffff" text-anchor="middle" letter-spacing="1">JAYSUING</text>
            <text x="200" y="186" font-family="Arial, sans-serif" font-weight="700" font-size="10" fill="#93c5fd" text-anchor="middle" letter-spacing="0.5">INVISIBLE WATERPROOF AGENT</text>
            <text x="200" y="200" font-family="Arial, sans-serif" font-size="8" fill="#e2e8f0" text-anchor="middle">Sellador Invisible de Altas Prestaciones</text>
            
            <!-- Brocha Aplicadora inclinada -->
            <g transform="rotate(35 290 140)">
              <!-- Mango de madera -->
              <rect x="270" y="40" width="16" height="110" rx="4" fill="#d97706"/>
              <!-- Parte metálica -->
              <rect x="266" y="145" width="24" height="25" fill="#94a3b8"/>
              <!-- Cerdas de la brocha con sellador -->
              <path d="M 266 170 C 266 195 290 195 290 170 Z" fill="#f8fafc" stroke="#cbd5e1"/>
            </g>

            <!-- Gotas de Agua / Impermeabilidad -->
            <path d="M 90 220 C 90 200 105 185 105 185 C 105 185 120 200 120 220 A 15 15 0 0 1 90 220 Z" fill="url(#dropGrad)" opacity="0.85"/>
            <path d="M 300 240 C 300 225 312 212 312 212 C 312 212 324 225 324 240 A 12 12 0 0 1 300 240 Z" fill="url(#dropGrad)" opacity="0.85"/>
          </svg>
        </div>

        <!-- 3 Puntos Clave bajo la imagen -->
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; background: #ffffff; padding: 14px 10px; border-top: 1px solid #e2e8f0; text-align: center; font-size: 0.8rem; font-weight: 700; color: #334155;">
          <div>💧 100% Invisible</div>
          <div style="border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0;">🖌️ Brocha Incluida</div>
          <div>☀️ Resiste Sol & Lluvia</div>
        </div>
      </div>
    </div>

    <!-- Columna Información de Compra y Oferta -->
    <div style="flex: 1 1 480px; min-width: 300px;">
      
      <!-- Reseñas -->
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
        <div style="color: #f59e0b; font-size: 1.1rem;">★★★★★</div>
        <span style="font-size: 0.88rem; font-weight: 700; color: #475569;">4.9 / 5.0 (384 opiniones verificadas en Venezuela)</span>
      </div>

      <!-- Título del Producto -->
      <h1 style="font-size: clamp(1.6rem, 3.2vw, 2.3rem); line-height: 1.2; font-weight: 800; color: #0f172a; margin: 0 0 14px 0;">
        Sellador Impermeabilizante Transparente Jaysuing (Invisible Waterproof Agent) + Brocha
      </h1>

      <p style="color: #475569; font-size: 1rem; line-height: 1.5; margin: 0 0 20px 0;">
        Elimina goteras, filtraciones en techos, fisuras en paredes, baños y baldosas sin romper cerámicas ni alterar la pintura. <strong>Capa protectora 100% transparente, elástica y permanente.</strong>
      </p>

      <!-- Barra de Urgencia de Inventario Real (14 unidades) -->
      <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; padding: 14px 18px; margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 800; color: #991b1b; margin-bottom: 8px;">
          <span>⚠️ ALERTA DE STOCK EN VENEZUELA:</span>
          <span>¡SOLO QUEDAN 14 UNIDADES!</span>
        </div>
        <div style="width: 100%; height: 10px; background: #fee2e2; border-radius: 10px; overflow: hidden;">
          <div style="width: 14%; height: 100%; background: #dc2626; border-radius: 10px; transition: width 0.3s;"></div>
        </div>
        <div style="font-size: 0.78rem; color: #7f1d1d; margin-top: 6px;">
          *Alta demanda por temporada de lluvias. Despachos inmediatos a Caracas y el interior.
        </div>
      </div>

      <!-- Selector de Ofertas / Bundles -->
      <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 26px;">
        
        <!-- Opción 1: 1 Pote -->
        <label style="border: 2px solid #e2e8f0; border-radius: 12px; padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; transition: all 0.2s;" onclick="selectBundle(1, 19.99)">
          <div style="display: flex; align-items: center; gap: 12px;">
            <input type="radio" name="bundle" id="bundle-1" style="width: 18px; height: 18px; accent-color: #0066cc;">
            <div>
              <div style="font-weight: 800; color: #0f172a; font-size: 1rem;">1 Pote (300g) + 1 Brocha</div>
              <div style="font-size: 0.8rem; color: #64748b;">Ideal para goteras puntuales o fisuras en ventanas</div>
            </div>
          </div>
          <div style="text-align: right;">
            <div style="font-size: 1.25rem; font-weight: 800; color: #0f172a;">$19,99 USD</div>
            <div style="font-size: 0.75rem; color: #64748b;">o Tasa Oficial BCV</div>
          </div>
        </label>

        <!-- Opción 2: 2 Potes (MÁS VENDIDO) -->
        <label style="border: 2px solid #0066cc; background: #eff6ff; border-radius: 12px; padding: 16px 18px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; position: relative;" onclick="selectBundle(2, 29.99)">
          <div style="position: absolute; top: -11px; right: 20px; background: #0066cc; color: #ffffff; font-size: 0.7rem; font-weight: 800; padding: 3px 10px; border-radius: 20px; text-transform: uppercase;">
            ⭐ MÁS VENDIDO (AHORRAS $10)
          </div>
          <div style="display: flex; align-items: center; gap: 12px;">
            <input type="radio" name="bundle" id="bundle-2" checked style="width: 18px; height: 18px; accent-color: #0066cc;">
            <div>
              <div style="font-weight: 800; color: #1e3a8a; font-size: 1.05rem;">Pack 2 Potes (600g) + 2 Brochas</div>
              <div style="font-size: 0.82rem; color: #2563eb; font-weight: 600;">🚚 ¡ENVÍO GRATIS A TODA VENEZUELA!</div>
            </div>
          </div>
          <div style="text-align: right;">
            <div style="font-size: 1.35rem; font-weight: 900; color: #0066cc;">$29,99 USD</div>
            <div style="font-size: 0.8rem; color: #94a3b8; text-decoration: line-through;">$39,99 USD</div>
          </div>
        </label>

      </div>

      <!-- Botón de Compra Rápida y WhatsApp -->
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <a id="btn-comprar" href="https://wa.me/?text=Hola%20quiero%20ordenar%20el%20Pack%20de%202%20Potes%20de%20Sellador%20Jaysuing%20(tienen%2014%20unidades%20en%20stock)" target="_blank" style="display: block; text-align: center; background: #00a650; color: #ffffff; text-decoration: none; padding: 18px 24px; border-radius: 12px; font-weight: 800; font-size: 1.15rem; box-shadow: 0 8px 20px rgba(0,166,80,0.35); transition: transform 0.2s;">
          🛒 ¡ORDENAR AHORA - PAGO MÓVIL / ZELLE!
        </a>
        
        <a id="btn-whatsapp" href="https://wa.me/?text=Hola%20quiero%20consultar%20por%20el%20Sellador%20Jaysuing%20Impermeabilizante%20para%20envio%20en%20Venezuela" target="_blank" style="display: flex; align-items: center; justify-content: center; gap: 10px; background: #25d366; color: #ffffff; text-decoration: none; padding: 14px 20px; border-radius: 12px; font-weight: 700; font-size: 1rem; box-shadow: 0 4px 14px rgba(37,211,102,0.25);">
          <span>💬</span> Consultar o Pedir Directo por WhatsApp
        </a>
      </div>

      <!-- Iconos de Métodos de Pago Locales en Venezuela -->
      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 16px; margin-top: 20px; font-size: 0.82rem; color: #475569; display: flex; flex-wrap: wrap; justify-content: space-around; gap: 12px; text-align: center;">
        <div>📲 <strong>Pago Móvil</strong> (Tasa Oficial BCV)</div>
        <div>💵 <strong>Zelle & Binance</strong> (USDT)</div>
        <div>🛵 <strong>Delivery Caracas</strong> & <strong>MRW/Zoom</strong></div>
      </div>

    </div>

  </div>

  <!-- Sección Demostrativa: Dónde Aplicarlo -->
  <div style="max-width: 1050px; margin: 60px auto 0; border-top: 1px solid #e2e8f0; padding-top: 40px;">
    <h2 style="text-align: center; font-size: clamp(1.4rem, 2.5vw, 2rem); font-weight: 800; color: #0f172a; margin-bottom: 30px;">
      Resuelve filtraciones en cualquier rincón de tu casa
    </h2>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 20px;">
      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; text-align: center;">
        <div style="font-size: 2.2rem; margin-bottom: 10px;">🏠</div>
        <h3 style="margin: 0 0 6px 0; font-size: 1.1rem; color: #0f172a;">Techos y Platabandas</h3>
        <p style="margin: 0; color: #64748b; font-size: 0.88rem;">Sella microfisuras expuestas al sol y la lluvia sin cuartearse.</p>
      </div>

      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; text-align: center;">
        <div style="font-size: 2.2rem; margin-bottom: 10px;">🚿</div>
        <h3 style="margin: 0 0 6px 0; font-size: 1.1rem; color: #0f172a;">Baños y Azulejos</h3>
        <p style="margin: 0; color: #64748b; font-size: 0.88rem;">Pásalo sobre las juntas de cerámica. Al ser transparente, no se nota.</p>
      </div>

      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; text-align: center;">
        <div style="font-size: 2.2rem; margin-bottom: 10px;">🪟</div>
        <h3 style="margin: 0 0 6px 0; font-size: 1.1rem; color: #0f172a;">Marcos de Ventanas</h3>
        <p style="margin: 0; color: #64748b; font-size: 0.88rem;">Evita que el agua entre por los bordes durante aguaceros fuertes.</p>
      </div>

      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; text-align: center;">
        <div style="font-size: 2.2rem; margin-bottom: 10px;">🧱</div>
        <h3 style="margin: 0 0 6px 0; font-size: 1.1rem; color: #0f172a;">Paredes y Concreto</h3>
        <p style="margin: 0; color: #64748b; font-size: 0.88rem;">Penetra profundamente bloqueando la humedad interna.</p>
      </div>
    </div>
  </div>

</div>

<script>
function selectBundle(pack, price) {
  const btn = document.getElementById('btn-comprar');
  if (pack === 1) {
    btn.href = "https://wa.me/?text=Hola%20quiero%20ordenar%201%20Pote%20de%20Sellador%20Jaysuing%20($19.99)%20(tienen%2014%20unidades%20en%20stock)";
  } else {
    btn.href = "https://wa.me/?text=Hola%20quiero%20ordenar%20el%20Pack%20de%202%20Potes%20de%20Sellador%20Jaysuing%20($29.99%20con%20Envio%20Gratis)%20(tienen%2014%20unidades%20en%20stock)";
  }
}
</script>

