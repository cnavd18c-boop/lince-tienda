<!-- Social Proof Toast Popup (Venex Import Style) -->
<div id="social-proof-toast" style="position: fixed; bottom: 20px; left: 20px; z-index: 99999; display: flex; align-items: center; gap: 14px; background: #ffffff; color: #1f2328; padding: 12px 18px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.18); border: 1px solid #e1e4e8; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; opacity: 0; transform: translateY(20px); transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1); pointer-events: none;">
  <div style="width: 42px; height: 42px; border-radius: 50%; background: #00a650; color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: 800; flex-shrink: 0;">
    <span id="sp-initial">C</span>
  </div>
  <div style="line-height: 1.35;">
    <div style="display: flex; align-items: center; gap: 6px;">
      <strong id="sp-name" style="font-size: 0.95rem; color: #111827;">Carmen R. de Caracas</strong>
      <span style="color: #00a650; font-size: 0.9rem;">✅</span>
    </div>
    <div style="font-size: 0.82rem; color: #4b5563;">
      compró <span style="font-weight: 600; color: #111827;">Sellador Jaysuing (Pack 2 Potes)</span>
    </div>
    <div id="sp-time" style="font-size: 0.75rem; color: #9ca3af; margin-top: 2px;">hace 2 min</div>
  </div>
</div>

<script>
(function() {
  const buyers = [
    { name: 'Carmen R. de Caracas', time: 'hace 2 min', item: 'Sellador Jaysuing (Pack 2)' },
    { name: 'José M. de Valencia', time: 'hace 4 min', item: 'Sellador Jaysuing + Brocha' },
    { name: 'Laura G. de Maracaibo', time: 'hace 7 min', item: 'Sellador Jaysuing (Pack 2)' },
    { name: 'Carlos B. de Maracay', time: 'hace 9 min', item: 'Sellador Jaysuing + Brocha' },
    { name: 'Elena V. de Barquisimeto', time: 'hace 12 min', item: 'Sellador Jaysuing (Pack 2)' },
    { name: 'Andrés P. de San Cristóbal', time: 'hace 15 min', item: 'Sellador Jaysuing (Pack 2)' },
    { name: 'Daniela S. de Lechería', time: 'hace 18 min', item: 'Sellador Jaysuing + Brocha' }
  ];

  const toast = document.getElementById('social-proof-toast');
  const nameEl = document.getElementById('sp-name');
  const initialEl = document.getElementById('sp-initial');
  const timeEl = document.getElementById('sp-time');
  let idx = 0;

  function showToast() {
    if (!toast) return;
    const b = buyers[idx];
    nameEl.textContent = b.name;
    initialEl.textContent = b.name.charAt(0);
    timeEl.textContent = b.time;

    toast.style.opacity = '1';
    toast.style.transform = 'translateY(0)';
    toast.style.pointerEvents = 'auto';

    setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transform = 'translateY(20px)';
      toast.style.pointerEvents = 'none';
      idx = (idx + 1) % buyers.length;
      setTimeout(showToast, Math.floor(Math.random() * 6000) + 7000);
    }, 4500);
  }

  setTimeout(showToast, 3000);
})();
</script>
